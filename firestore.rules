rules_version = '2';

// F3 Campfire — the crew's fire is private to people who have the link AND a
// Google account. Ownership of goals is enforced here, not in the browser.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(crewId) {
      return signedIn() && exists(
        /databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid)
      );
    }

    // The guy who lit the fire runs it. He can take a seat back and clear a
    // man's goals — but note he is never granted *write* over anyone's goals
    // below, only delete. Nobody can put words in another man's mouth.
    function isCrewOwner(crewId) {
      return signedIn() && get(
        /databases/$(database)/documents/crews/$(crewId)
      ).data.createdBy == request.auth.uid;
    }

    match /crews/{crewId} {

      // You need the crew id to read the doc — ids are random, so the link is
      // the capability. Listing all crews is never allowed.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;

      // Only the guy who lit the fire can rename it, and he can't hand it off.
      allow update: if signedIn()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      match /members/{memberId} {
        // Everyone at the fire can see who else is there.
        allow read: if isMember(crewId) || request.auth.uid == memberId;

        // A hand-drawn constellation is user-controlled data, so bound it here
        // as well as in the editor. Exactly ten stars — one per goal — is what
        // keeps everyone on the same season. Absent or null is fine; that means
        // "use the shape his F3 name picked".
        function shapeOk() {
          return !('customShape' in request.resource.data)
                 || request.resource.data.customShape == null
                 || (
                      request.resource.data.customShape.stars is list
                      && request.resource.data.customShape.stars.size() == 10
                      && request.resource.data.customShape.edges is list
                      && request.resource.data.customShape.edges.size() <= 40
                      && (!('label' in request.resource.data.customShape)
                          || request.resource.data.customShape.label == null
                          || request.resource.data.customShape.label.size() <= 24)
                    );
        }

        // You write your own member doc and nobody else's. Joining is exactly
        // this create — anyone with the link who signs in may take a seat.
        allow create: if signedIn()
                      && request.auth.uid == memberId
                      && request.resource.data.uid == memberId
                      && request.resource.data.f3Name is string
                      && request.resource.data.f3Name.size() > 0
                      && request.resource.data.f3Name.size() <= 28
                      && shapeOk();

        allow update: if signedIn()
                      && request.auth.uid == memberId
                      && request.resource.data.uid == memberId
                      && request.resource.data.f3Name.size() <= 28
                      && shapeOk();

        allow delete: if signedIn()
                      && (request.auth.uid == memberId || isCrewOwner(crewId));
      }

      match /goals/{goalId} {
        // Read the whole crew's goals; you have to be at the fire.
        allow read: if isMember(crewId);

        allow create: if isMember(crewId)
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 80
                      && request.resource.data.achieved is bool;

        // His goal, his call — and he can't reassign it to somebody else.
        allow update: if isMember(crewId)
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.title.size() <= 80;

        allow delete: if isMember(crewId)
                      && (resource.data.uid == request.auth.uid || isCrewOwner(crewId));
      }
    }
  }
}
